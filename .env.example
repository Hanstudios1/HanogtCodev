# Hanogt Codev environment variables — names only, never real values.
# Copy to .env.local for local development; in production set them in
# Vercel > Project > Settings > Environment Variables and redeploy.
# Full descriptions: docs/ENVIRONMENT.md. Secrets must never use a
# NEXT_PUBLIC_ prefix (those are shipped to every browser).

# --- Authentication (NextAuth) ---------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOTP_ENCRYPTION_KEY=

# --- Firebase: browser (public) --------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# --- Firebase: server (secret) — one of these forms ------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Payments: Paddle Billing -----------------------------------------------
# Sandbox and live are separate Paddle accounts. The environment follows the
# key prefixes (pdl_sdbx_/test_ = sandbox, pdl_live_/live_ = live), so going
# live means replacing these three values with the live ones and redeploying.
# Server-side API key (Paddle > Developer tools > Authentication). SECRET.
PADDLE_API_KEY=
# Client-side token for Paddle.js (test_… or live_…). Public.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Secret key of the notification destination that points to
# https://<your domain>/api/paddle/webhook (Developer tools > Notifications). SECRET.
PADDLE_WEBHOOK_SECRET=
# Optional: only needed for keys created before May 2025 (no prefix): sandbox | production
# NEXT_PUBLIC_PADDLE_ENV=
# Optional: separate secret for signing checkout custom data (defaults to NEXTAUTH_SECRET).
# PADDLE_LINK_SECRET=

# --- Hanogt Social voice calls (WebRTC) --------------------------------------
# TURN relay for networks that block direct connections (mobile carriers,
# company and school networks). Comma-separated URLs, e.g.
# turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
TURN_SERVER_URL=
# coturn "static-auth-secret" (use-auth-secret / TURN REST credentials). SECRET.
TURN_SHARED_SECRET=

# --- Hanogt AI ----------------------------------------------------------------
HANOGT_AI_API_KEY=
# HANOGT_AI_BASE_URL=https://api.groq.com/openai/v1
# HANOGT_AI_MODEL=llama-3.3-70b-versatile
# Key for encrypting the API keys people connect in Hanogt AI (falls back to
# TOTP_ENCRYPTION_KEY, then NEXTAUTH_SECRET). Set it before launch and never
# change it: stored keys can't be decrypted with a new value. SECRET.
AI_KEYS_ENCRYPTION_KEY=

# --- Administration and operations ------------------------------------------
ADMIN_EMAILS=
HEALTH_CHECK_TOKEN=
CODE_RUNNER_URL=
RATE_LIMIT_SALT=
NEXT_PUBLIC_SITE_URL=

# --- Local development with the Firebase Emulator Suite ---------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
