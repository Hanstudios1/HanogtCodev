{
  "name": "hanogt-codev",
  "version": "1.0.0",
  "description": "Hanogt Codev - Online Code Editor",
  "private": true,
  "main": "electron/main.js",
  "author": "HanStudios",
  "scripts": {
    "prepare:assets": "node scripts/copy-monaco.mjs && node scripts/build-player.mjs && node scripts/copy-runtimes.mjs",
    "predev": "npm run prepare:assets",
    "dev": "next dev",
    "prebuild": "npm run prepare:assets",
    "build": "next build",
    "start": "next start",
    "preexport": "npm run prepare:assets",
    "export": "next build",
    "lint": "eslint",
    "i18n:check": "node scripts/audit-i18n.mjs",
    "electron-start": "npx electron .",
    "electron-dev": "set ELECTRON_DEV=true && npx electron .",
    "dist": "npm run export && electron-builder",
    "dist:win": "npm run export && electron-builder --win",
    "dist:linux": "npm run export && electron-builder --linux"
  },
  "build": {
    "appId": "com.hanstudios.hanogt-codev",
    "productName": "Hanogt Codev",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo-dark.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo-dark.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^12.43.0",
    "immer": "^11.1.18",
    "jszip": "^3.10.2",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.57.0",
    "next": "16.3.6",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "pyodide": "^314.0.7",
    "sql.js": "^1.14.2",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "wasmoon": "^1.16.0"
  }
}
