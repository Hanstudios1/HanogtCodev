rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.app == "hanogt-codev";
    }

    function email() {
      return request.auth.token.email;
    }

    function isSelf(id) {
      return signedIn() && email() == id;
    }

    function chatParticipant(chatId) {
      return signedIn()
        && email() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function callParticipant(callId) {
      return signedIn()
        && email() in get(/databases/$(database)/documents/calls/$(callId)).data.participants;
    }

    function groupMember(groupId) {
      return signedIn()
        && email() in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    function groupManager(groupId) {
      return groupMember(groupId)
        && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.ownerEmail == email()
          || email() in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
        );
    }

    // Fields a user may write on their own users/{email} document. Everything
    // else (friends, blockedUsers, role, suspension, credentials…) is server-only:
    // the friend graph is trusted by the chat/call rules and the APIs below.
    // Presence (isOnline, lastSeenAt, dndMode, presence, presenceState,
    // statusPreference) is written by /api/presence and /api/account/profile only,
    // so the privacy settings can't be bypassed from the browser.
    function userEditableKeys() {
      return [
        "email", "username", "avatarUrl", "bio", "emailNotifications", "newFeatureAlerts",
        "publicProfile", "showOnlineStatus", "timezone", "nickname", "nicknameTag", "customStatus",
        "statusEmoji", "bannerUrl", "accentColor", "favoriteLangs", "socialGithub", "socialLinkedin",
        "socialTwitter", "socialWebsite", "socialYoutube", "socialTiktok", "socialInstagram",
        "socialFacebook", "lastLoginDate", "updatedAt", "typingIndicator", "readReceipts",
        "msgFontSize", "chatBackground", "voiceMsgQuality", "linkPreview", "gifAutoplay",
        "enterToSend", "stickerSuggestions", "whoCanAdd", "hideFriendList", "showLastSeen",
        "photoVisibility", "bioVisibility", "publicProjects", "msgNotifications", "callNotifications",
        "friendReqNotifications", "likeNotifications", "notifSound", "dndSchedule",
        "bubbleColor", "compactMode", "reduceAnimations", "highContrast", "uiFontSize", "emojiStyle"
      ];
    }

    function profileEditableKeys() {
      return [
        "email", "username", "avatarUrl", "nickname", "nicknameTag", "bio", "bannerUrl", "accentColor",
        "favoriteLangs", "socialGithub", "socialLinkedin", "socialTwitter", "socialWebsite",
        "customStatus", "statusEmoji", "publicProfile", "publicProjects", "updatedAt"
      ];
    }

    // True when the write creates the document or changes `key`; validation of
    // untouched legacy values must not block unrelated updates.
    function touches(key) {
      return resource == null || request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
    }

    function textField(key, max) {
      return !(key in request.resource.data) || !touches(key) || request.resource.data[key] == null
        || (request.resource.data[key] is string && request.resource.data[key].size() <= max);
    }

    function urlField(key) {
      return !(key in request.resource.data) || !touches(key) || request.resource.data[key] == null
        || request.resource.data[key] == ""
        || (request.resource.data[key] is string && request.resource.data[key].size() <= 2048
          && request.resource.data[key].matches('https://[^ <>()]+'));
    }

    function colorField(key) {
      return !(key in request.resource.data) || !touches(key) || request.resource.data[key] == null
        || request.resource.data[key] == ""
        || (request.resource.data[key] is string && request.resource.data[key].matches('#[0-9a-fA-F]{3,8}'));
    }

    function validProfileFields() {
      return textField("username", 100) && textField("nickname", 100) && textField("bio", 2000)
        && textField("customStatus", 300) && textField("statusEmoji", 32)
        && (!("nicknameTag" in request.resource.data) || !touches("nicknameTag")
          || (request.resource.data.nicknameTag is string && request.resource.data.nicknameTag.matches('[0-9]{4}')))
        && urlField("avatarUrl") && urlField("bannerUrl") && colorField("accentColor");
    }

    // Voice files must live in the owning chat/group folder: `<prefix>/<id>/<file>`.
    // The server deletes these paths when chats, groups or accounts are removed.
    function validVoicePath(path, prefix, containerId) {
      return path is string
        && path.split('/').size() == 3
        && path.split('/')[0] == prefix
        && path.split('/')[1] == containerId
        && path.split('/')[2].size() > 0
        && path.split('/')[2].size() <= 200;
    }

    function voicePathOk(data, prefix, containerId) {
      return !("voicePath" in data) || data.voicePath == null || validVoicePath(data.voicePath, prefix, containerId);
    }

    match /credentials/{id} {
      allow read, write: if false;
    }

    match /security_rate_limits/{id} {
      allow read, write: if false;
    }

    match /security_events/{id} {
      allow read, write: if false;
    }

    match /media_posts/{postId} {
      allow read, write: if false;
      match /files/{fileId} {
        allow read, write: if false;
      }
    }

    match /media_likes/{id} {
      allow read, write: if false;
    }

    match /media_comments/{id} {
      allow read, write: if false;
    }

    match /media_reports/{id} {
      allow read, write: if false;
    }

    match /security_training_contributions/{id} {
      allow read, write: if false;
    }

    // Game projects and native-language script sources are mediated by the
    // authenticated API so scene/schema and ownership checks cannot be bypassed.
    match /game_projects/{projectId} {
      allow read, write: if false;
      match /scripts/{scriptId} {
        allow read, write: if false;
      }
    }

    // Published games, likes, news comments and the AI arena are served by
    // rate-limited API routes only (validation, moderation, privacy).
    match /arcade_games/{gameId} {
      allow read, write: if false;
    }

    match /arcade_likes/{likeId} {
      allow read, write: if false;
    }

    match /news_comments/{commentId} {
      allow read, write: if false;
    }

    match /news_meta/{newsId} {
      allow read, write: if false;
    }

    match /news_cache/{cacheId} {
      allow read, write: if false;
    }

    match /arena_votes/{voteId} {
      allow read, write: if false;
    }

    match /arena_stats/{modelId} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && email() in resource.data.members;
      allow write: if false;

      match /files/{fileId} {
        allow read: if groupMember(groupId);
        allow create, update: if groupMember(groupId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.lang is string
          && request.resource.data.lang.size() <= 30
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 500000
          && request.resource.data.updatedBy == email()
          && request.resource.data.keys().hasOnly(["name", "lang", "code", "order", "updatedBy", "updatedAt"]);
        allow delete: if groupManager(groupId);
      }

      match /messages/{messageId} {
        allow read: if groupMember(groupId);
        allow create: if groupMember(groupId)
          && request.resource.data.fromEmail == email()
          && request.resource.data.type in ["text", "voice"]
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly(["fromEmail", "author", "authorAvatar", "type", "text", "voicePath", "voiceDuration", "createdAt"])
          && voicePathOk(request.resource.data, "group-voice-messages", groupId);
        allow update: if false;
        allow delete: if groupMember(groupId) && resource.data.fromEmail == email();
      }
    }

    match /group_invites/{inviteId} {
      allow read, write: if false;
    }

    // Users documents are created by the server only (sign-up, Google sign-in).
    // A still-open tab of a deleted account must not bring its document back
    // through the presence heartbeat (a merge write that becomes a create).
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if false;
      allow update: if isSelf(userId)
        && request.resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableKeys())
        && validProfileFields();
      allow delete: if false;
    }

    match /public_profiles/{userId} {
      allow read: if signedIn();
      // Badges are server-only (they include "verified"). Only an existing
      // account gets a profile: a deleted account's open tab can't recreate it.
      allow create: if isSelf(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(profileEditableKeys())
        && validProfileFields();
      allow update: if isSelf(userId)
        && request.resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileEditableKeys())
        && validProfileFields();
      allow delete: if isSelf(userId);
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromEmail == email() || resource.data.toEmail == email());
      allow create: if signedIn()
        && request.resource.data.fromEmail == email()
        && request.resource.data.toEmail != email()
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(["fromEmail", "toEmail", "status", "createdAt"]);
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && email() in resource.data.participants;
      allow create: if signedIn()
        && email() in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && (
          (request.resource.data.participants[0] == email() && request.resource.data.participants[1] in get(/databases/$(database)/documents/users/$(email())).data.friends)
          || (request.resource.data.participants[1] == email() && request.resource.data.participants[0] in get(/databases/$(database)/documents/users/$(email())).data.friends)
        );
      allow update: if chatParticipant(chatId)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage", "lastMessageAt", "lastSender", "typingUser", "updatedAt"
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSender"])
          || request.resource.data.lastSender == email())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastMessage"])
          || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4100))
        && (!request.resource.data.keys().hasAny(["typingUser"])
          || request.resource.data.typingUser == null
          || request.resource.data.typingUser == email());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatParticipant(chatId);
        allow create: if chatParticipant(chatId)
          && request.resource.data.fromEmail == email()
          && request.resource.data.type in ["text", "sticker", "voice"]
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly([
            "fromEmail", "text", "type", "stickerUrl", "voicePath", "voiceDuration", "createdAt", "read", "replyTo"
          ])
          && (!("read" in request.resource.data) || request.resource.data.read == false)
          && voicePathOk(request.resource.data, "voice-messages", chatId);
        allow update: if chatParticipant(chatId)
          && request.resource.data.fromEmail == resource.data.fromEmail
          && (
            (
              resource.data.fromEmail == email()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "text", "edited", "deleted", "voicePath", "voiceDuration"
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 4000
              && voicePathOk(request.resource.data, "voice-messages", chatId)
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
              && resource.data.fromEmail != email()
              && request.resource.data.read == true
            )
          );
        allow delete: if chatParticipant(chatId) && resource.data.fromEmail == email();
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && email() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.caller == email()
        && request.resource.data.callee != email()
        && request.resource.data.participants == [request.resource.data.caller, request.resource.data.callee]
        && request.resource.data.callee in get(/databases/$(database)/documents/users/$(email())).data.friends
        && request.resource.data.status in ["preparing", "ringing"];
      allow update: if callParticipant(callId)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee
        && request.resource.data.status in ["preparing", "ringing", "active", "declined", "ended"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "offer", "answer", "answeredAt", "callerCandidates", "calleeCandidates"
        ]);
      allow delete: if callParticipant(callId);

      match /{candidateCollection}/{candidateId} {
        allow read, create, delete: if candidateCollection in ["callerCandidates", "calleeCandidates"]
          && callParticipant(callId);
        allow update: if false;
      }
    }

    // Live coding sessions in the editor ("Ekiple düzenle"), written only by
    // /api/collab with the service account. Participants (the e-mails in the
    // session document) read the live documents with the client SDK: the
    // public meta (no e-mail addresses), the Yjs update log, presence, chat
    // and their own signalling inbox. The session document (participant
    // addresses, invitees) and the snapshots stay server-only.
    match /collab_sessions/{sessionId} {
      function collabSession() {
        return get(/databases/$(database)/documents/collab_sessions/$(sessionId)).data;
      }

      function collabMember() {
        return signedIn() && email() in collabSession().participants;
      }

      allow read, write: if false;

      match /live/{docId} {
        allow read: if collabMember();
        allow write: if false;
      }

      match /updates/{updateId} {
        allow read: if collabMember();
        allow write: if false;
      }

      match /presence/{presenceId} {
        allow read: if collabMember();
        allow write: if false;
      }

      match /chat/{messageId} {
        allow read: if collabMember();
        allow write: if false;
      }

      match /inbox/{participantKey}/signals/{signalId} {
        allow read: if collabMember() && collabSession().keys[email()] == participantKey;
        allow write: if false;
      }

      match /snapshots/{partId} {
        allow read, write: if false;
      }
    }

    // New code projects are created by POST /api/projects, which applies the
    // plan's project limit; owners then write the files and update the project.
    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.email == email() || resource.data.visibility == "public");
      allow create: if false;
      allow update, delete: if signedIn()
        && resource.data.email == email()
        && request.resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasNone(["email"]);

      match /files/{fileId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/projects/$(projectId)).data.email == email()
            || get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == "public");
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.email == email()
          && (!request.resource.data.keys().hasAny(["email", "owner", "role"]))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.lang is string
          && request.resource.data.lang.size() <= 30
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 500000;
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.email == email();
      }
    }

    // Served by /api/feedback only: the documents contain e-mail addresses.
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // Support tickets (Feedback/FAQ > Destek talepleri) are private between the
    // author and the Hanogt team: served only by /api/support and /api/admin/tickets.
    match /support_tickets/{ticketId} {
      allow read, write: if false;
    }

    // Served by /api/notifications (reading, marking read, deleting); the
    // browser no longer touches these documents directly.
    match /notifications/{userId}/items/{itemId} {
      allow read, write: if false;
    }

    match /changelog_comments/{version}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.email == email()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.keys().hasOnly(["text", "email", "username", "avatarUrl", "createdAt"]);
      allow update: if signedIn()
        && resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text"])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow delete: if signedIn() && resource.data.email == email();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
